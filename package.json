{
  "name": "todo-api",
  "version": "1.0.0",
  "description": "Minimal Node.js and Express To-Do API with in-memory array storage",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"*.json\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "",
  "license": "ISC"
}
